#!/bin/bash

# ============================================================
# AI PPT Desktop - 一键启动脚本
# ============================================================
# 使用方法:
#   ./start              启动应用（完整流程）
#   ./start setup        仅安装依赖
#   ./start run          仅运行应用
#   ./start build        构建发布版本
#   ./start test         运行测试
#   ./start clean        清理缓存
#   ./start help         显示帮助
# ============================================================

set -e

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# 打印横幅
print_banner() {
    echo -e "${CYAN}"
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║           🚀 AI PPT Desktop - 一键启动                   ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

# 打印状态
print_status() {
    echo -e "${BLUE}[▶]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

print_error() {
    echo -e "${RED}[✗]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[!]${NC} $1"
}

# 检查命令是否存在
check_command() {
    if command -v "$1" &> /dev/null; then
        return 0
    else
        return 1
    fi
}

# 检查Flutter环境
check_flutter() {
    if ! check_command flutter; then
        print_error "Flutter 未安装"
        echo ""
        echo "请先安装 Flutter:"
        echo "  macOS:   brew install --cask flutter"
        echo "  Linux:   https://flutter.dev/docs/get-started/install/linux"
        echo "  Windows: https://flutter.dev/docs/get-started/install/windows"
        exit 1
    fi
    
    FLUTTER_VERSION=$(flutter --version 2>/dev/null | head -1)
    print_success "Flutter: $FLUTTER_VERSION"
}

# 安装依赖
install_deps() {
    print_status "安装项目依赖..."
    flutter pub get
    print_success "依赖安装完成"
}

# 运行应用
run_app() {
    print_status "启动应用..."
    
    # 检测平台
    case "$(uname -s)" in
        Darwin)
            DEVICE="macos"
            ;;
        Linux)
            DEVICE="linux"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            DEVICE="windows"
            ;;
        *)
            DEVICE="chrome"
            ;;
    esac
    
    print_status "平台: $DEVICE"
    flutter run -d "$DEVICE" --hot
}

# 构建应用
build_app() {
    print_status "构建应用..."
    
    case "$(uname -s)" in
        Darwin)
            flutter build macos --release
            print_success "构建完成: build/macos/Build/Products/Release/"
            ;;
        Linux)
            flutter build linux --release
            print_success "构建完成: build/linux/x64/release/bundle/"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            flutter build windows --release
            print_success "构建完成: build/windows/x64/runner/Release/"
            ;;
        *)
            flutter build web --release
            print_success "构建完成: build/web/"
            ;;
    esac
}

# 运行测试
run_tests() {
    print_status "运行测试..."
    flutter test
    print_success "测试完成"
}

# 清理缓存
clean_cache() {
    print_status "清理缓存..."
    flutter clean
    rm -rf build/ .dart_tool/
    print_success "清理完成"
}

# 显示帮助
show_help() {
    print_banner
    echo "使用方法:"
    echo "  ./start [命令]"
    echo ""
    echo "命令:"
    echo "  (无参数)    完整流程：检查环境 + 安装依赖 + 运行应用"
    echo "  setup       仅安装依赖"
    echo "  run         仅运行应用"
    echo "  build       构建发布版本"
    echo "  test        运行测试"
    echo "  clean       清理缓存"
    echo "  help        显示此帮助"
    echo ""
    echo "示例:"
    echo "  ./start          # 首次运行，自动安装依赖并启动"
    echo "  ./start run      # 快速启动（依赖已安装）"
    echo "  ./start build    # 构建发布版本"
    echo ""
    echo "快捷方式:"
    echo "  双击 start 文件（macOS/Linux）"
    echo "  或在终端运行 ./start"
}

# 完整流程
full_setup() {
    print_banner
    check_flutter
    install_deps
    run_app
}

# 主函数
main() {
    case "${1:-}" in
        "")
            full_setup
            ;;
        setup)
            print_banner
            check_flutter
            install_deps
            ;;
        run)
            print_banner
            check_flutter
            run_app
            ;;
        build)
            print_banner
            check_flutter
            build_app
            ;;
        test)
            print_banner
            check_flutter
            run_tests
            ;;
        clean)
            print_banner
            clean_cache
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            print_error "未知命令: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# 运行主函数
main "$@"